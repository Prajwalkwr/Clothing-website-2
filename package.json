{
  "name": "aavaran-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node --watch server/index.mjs\" \"vite --host 0.0.0.0 --port 5173\"",
